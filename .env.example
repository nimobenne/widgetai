# Server-only key from a dedicated OpenAI project. Use prepaid credit; auto-recharge off.
OPENAI_API_KEY=
# Chat Completions model; must support max_tokens and temperature.
OPENAI_MODEL=gpt-4o-mini
# Only the literal true enables model calls. Missing or any other value disables chat.
CHAT_ENABLED=false
# Neon Postgres URL. Required in production; absent locally selects an in-memory store.
DATABASE_URL=
# Random secret for HMAC widget tokens; required in development and production.
WIDGET_SIGNING_SECRET=
# Independent random secret used to salt the SHA-256 IP hash; required for chat.
IP_SALT=
# Global message reservations across all sites, including rejected attempts. Zero blocks chat.
DAILY_MESSAGE_CAP=60
MONTHLY_MESSAGE_CAP=1200
# Random bearer secret for Vercel's daily /api/cron/prune request.
CRON_SECRET=
